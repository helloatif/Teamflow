NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamflow?schema=public
JWT_SECRET=replace-with-a-unique-development-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-unique-development-refresh-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
REDIS_URL=redis://localhost:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=teamflow
